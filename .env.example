# Copy to .env for Docker Compose. Never commit the real .env file.
POSTGRES_DB=gifjam
POSTGRES_USER=gifjam
POSTGRES_PASSWORD=replace_with_a_long_random_password

ASPNETCORE_ENVIRONMENT=Production
API_HOST_PORT=5042
FRONTEND_HOST_PORT=4200
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_URL=http://localhost:4200

DISCORD_CLIENT_ID=replace_with_discord_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:5042/api/auth/discord/callback
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_DEVELOPMENT_GUILD_ID=
DISCORD_BOT_ACTIVITY=GifJam

# At least 64 random characters. Generate a different value for production.
JWT_SIGNING_KEY=replace_with_at_least_64_random_characters_for_the_jwt_signing_key
JWT_ISSUER=GifJam.Api
JWT_AUDIENCE=GifJam.Web
JWT_LIFETIME_HOURS=8

KLIPY_API_KEY=replace_with_klipy_api_key
GIPHY_API_KEY=replace_with_giphy_api_key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
