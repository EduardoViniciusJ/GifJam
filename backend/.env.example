# Local infrastructure
POSTGRES_DB=gifjam
POSTGRES_USER=gifjam
POSTGRES_PASSWORD=replace_with_a_random_local_password
POSTGRES_HOST_PORT=5432

# Application URLs
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7042;http://localhost:5042
GIFJAM_FRONTEND_URL=http://localhost:4200
GIFJAM_API_HTTPS_URL=https://localhost:7042
GIFJAM_DISCORD_CALLBACK_URL=https://localhost:7042/api/auth/discord/callback

# Application connection
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=gifjam;Username=gifjam;Password=replace_with_the_same_local_password
Neon__ProjectId=replace_with_the_neon_project_id
ConnectionStrings__Neon=replace_with_the_pooled_neon_connection_string
ConnectionStrings__NeonDirect=replace_with_the_direct_neon_connection_string

# Discord OAuth2: never commit real values
Discord__ClientId=replace_after_creating_the_discord_app
Discord__ClientSecret=replace_after_creating_the_discord_app
Discord__CallbackUrl=https://localhost:7042/api/auth/discord/callback
# Enable only after adding the bot user to the existing Discord application.
Discord__BotEnabled=false
Discord__BotToken=replace_with_the_bot_token
# Use a test server ID for instant slash-command updates; leave empty in production for a global command.
Discord__DevelopmentGuildId=
Discord__BotActivity=GifJam

# KLIPY: never commit the real key
Klipy__ApiKey=replace_after_creating_the_klipy_platform
Klipy__BaseUrl=https://api.klipy.com
Klipy__Locale=pt_BR
Klipy__Country=BR
Klipy__ContentFilter=high

# GIPHY: never commit the real key
Giphy__ApiKey=replace_after_creating_the_giphy_api_key
Giphy__BaseUrl=https://api.giphy.com
Giphy__Language=pt
Giphy__Rating=g
Giphy__Bundle=messaging_non_clips

# Gemini: server-side only; the backend calls the REST API without an SDK
Gemini__ApiKey=replace_after_creating_the_gemini_api_key
Gemini__Model=gemini-3.5-flash
Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta/
Gemini__TimeoutSeconds=10

# Use at least 64 random characters outside development
Jwt__SigningKey=replace_with_at_least_64_random_characters
Jwt__Issuer=GifJam.Api
Jwt__Audience=GifJam.Web
Jwt__LifetimeHours=8

# Public frontend URL used for OAuth redirects and CORS
ApplicationUrls__FrontendUrl=http://localhost:4200
